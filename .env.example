# Copy this file to .env.local and fill in your own values. Nothing
# here is stored in the database or hardcoded anywhere in the app.

# --- Database (required for Phase 10) ---
# Single target PostgreSQL connection; it also stores ProtoDB's
# protodb_admin records. A DB-backed session is required for signed-in
# pages, so without this URL users cannot authenticate into demo pages.
DATABASE_URL=postgres://user:password@host:5432/dbname
# Enable TLS for remote databases. Certificates are verified by default.
DATABASE_SSL=false
DATABASE_SSL_CA=
# Development-only self-signed certificate opt-in; rejected in production.
DATABASE_SSL_ALLOW_SELF_SIGNED=false

# Separate least-privilege credential used only for authorized DDL.
# Must use the SAME hostname, port, and database as DATABASE_URL.
# Runtime server/database identity is also compared; mismatch or unknown
# identity disables DDL. Never expose either URL to browser code.
DATABASE_DDL_URL=
DATABASE_DDL_SSL=false
DATABASE_DDL_SSL_CA=
# Development-only self-signed certificate opt-in; rejected in production.
DATABASE_DDL_SSL_ALLOW_SELF_SIGNED=false

# --- Credential Encryption (optional, Phase 10) ---
# 256-bit secret (64 hex characters or 32 bytes) used for authenticated
# AES-256-GCM envelope encryption of stored credentials. Keys are derived
# using HKDF-SHA256 with workspace and credential-type domain separation.
# Leave empty if credentials are only read from environment variables.
CREDENTIAL_ENCRYPTION_KEY=

# --- Object storage (optional for Phase 7) ---
# Without STORAGE_PROVIDER, Storage stays in explicitly labeled demo mode.
# Live mode stores object bytes in this private physical S3 bucket and
# logical bucket/file metadata in PostgreSQL. The same variables cover
# every S3-compatible backend (names are stable — do not rename per
# provider); only the combination changes:
# - AWS S3: STORAGE_PROVIDER=s3, S3_BUCKET + S3_REGION, no S3_ENDPOINT.
#   Leave keys unset when the server has an IAM role.
# - Cloudflare R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com,
#   S3_REGION=auto, R2 API token as the key pair, path style on.
# - Backblaze B2: S3_ENDPOINT=https://s3.<region>.backblazeb2.com with a
#   B2 application key as the key pair, path style on.
# - Local emulator (development only): loopback HTTP such as
#   http://127.0.0.1:9000. Remote plain-HTTP endpoints are rejected.
# Never bake a developer PC/phone into production storage configuration.
STORAGE_PROVIDER=
S3_BUCKET=
S3_REGION=us-east-1
# For local MinIO or another S3-compatible endpoint:
S3_ENDPOINT=
# Leave credentials unset on AWS when the server has an IAM role.
# MinIO and other custom endpoints require both values.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Defaults to true when S3_ENDPOINT is set; false for AWS S3.
S3_FORCE_PATH_STYLE=

# --- Google OAuth login (optional) ---
# Enables the "Continue with Google" button. All three are server-only;
# the secret never reaches browser code. Register an OAuth client in
# Google Cloud Console (APIs & Services > Credentials), add this app's
# callback URL under "Authorized redirect URIs", and apply migration
# migrations/005_google_identities.sql before enabling.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# After setting DATABASE_URL, run the migration once:
#   psql "$DATABASE_URL" -f migrations/001_protodb_admin_schema.sql
#   psql "$DATABASE_URL" -f migrations/002_sql_editor_history.sql
#   psql "$DATABASE_URL" -f migrations/003_storage_metadata.sql
#   psql "$DATABASE_URL" -f migrations/004_phase10_owner_invariant.sql
#   psql "$DATABASE_URL" -f migrations/005_google_identities.sql
# Then start the app and visit /login -- since a fresh database has no
# users yet, you'll be walked through creating the first admin account.
